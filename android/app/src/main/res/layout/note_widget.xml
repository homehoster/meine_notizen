<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Notizen" android:textColor="#80CBC4"
        android:textSize="12sp" android:textStyle="bold" android:paddingBottom="4dp"/>

    <TextView android:id="@+id/n0" style="@style/NoteRow"/>
    <TextView android:id="@+id/n1" style="@style/NoteRow"/>
    <TextView android:id="@+id/n2" style="@style/NoteRow"/>
    <TextView android:id="@+id/n3" style="@style/NoteRow"/>
    <TextView android:id="@+id/n4" style="@style/NoteRow"/>
</LinearLayout>
