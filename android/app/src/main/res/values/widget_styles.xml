<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetActionTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#008577</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
    <style name="NoteTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Subhead</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="NotePreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Body1</item>
        <item name="android:textColor">#DDFFFFFF</item>
        <item name="android:maxLines">5</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
